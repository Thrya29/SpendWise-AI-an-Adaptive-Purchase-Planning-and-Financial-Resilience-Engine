# Copy to .env, or run:  python scripts/generate_env.py
# Never commit .env. All values below are placeholders.

POSTGRES_USER=spendwise
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=spendwise

# >= 32 random characters
SPENDWISE_JWT_SECRET=replace-with-at-least-32-random-characters
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SPENDWISE_ENCRYPTION_KEY=replace-with-a-fernet-key

# Secure cookies work on http://localhost in Chrome, Edge and Firefox.
# Set to false only for plain-HTTP access from another hostname in a trusted network.
SPENDWISE_COOKIE_SECURE=true

# Port the web app is published on
WEB_PORT=3000
